set_location_assignment PIN_47 -to seg_ones[2]
set_location_assignment PIN_48 -to seg_ones[3]
set_location_assignment PIN_49 -to seg_ones[4]
set_location_assignment PIN_50 -to seg_ones[5]
set_location_assignment PIN_51 -to seg_ones[6]
